# Copy to `.env` (same folder as docker-compose.yml) and fill in. NEVER commit .env.
# Used by docker-compose.yml only. The native workers read backend/.env
# (see backend/.env.example).

# --- Images ---
# IMAGE_TAG is managed by deploy/deploy.ps1: production always runs an immutable
# sha-<40-hex commit> tag and the script rewrites this line after every
# verified deploy (so a manual `docker compose up -d` keeps the same version).
# `latest` is only a convenience for manual testing and is never deployed.
GHCR_OWNER=your-github-username-lowercase
IMAGE_TAG=latest

# --- Public address (the https URL users open; no trailing slash) ---
# Tailscale Serve: https://vireon.<your-tailnet>.ts.net
# Quick tunnel / local test: http://localhost:8080
PUBLIC_URL=http://localhost:8080

# --- Database (MongoDB Atlas free tier, as in backend/.env) ---
MONGODB_URI=

# --- MinIO (native on Windows; same values as backend/.env) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Tailscale (only for the `tailscale` profile) ---
# Admin console -> Settings -> Keys -> generate an auth key (reusable, tag optional)
TS_AUTHKEY=

# --- Publishing (YouTube upload). Optional: leave empty and the Publishing page says "not configured".
# Setup: docs/publishing.md. The SAME encryption key must also be in backend/.env (native YouTube worker),
# and in the dev clone's backend/.env - dev and prod share one database, so a different key makes the stored
# YouTube login unreadable on the other side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# https://<PUBLIC_URL host>/api/publishing/oauth/google/callback  (register this exact URL on the Google OAuth client)
GOOGLE_REDIRECT_URI=
PUBLISHING_TOKEN_ENCRYPTION_KEY=
# true only after YouTube's API audit has passed (otherwise uploads are locked to private)
YOUTUBE_API_VERIFIED=false

# --- Promotion Studio (Facebook Pages, Instagram, Threads). Optional: leave empty and the page says "not configured".
# Setup: docs/social-promotion.md. Uses the same PUBLISHING_TOKEN_ENCRYPTION_KEY as above (also needed in backend/.env
# for the native social worker). Placeholders only - never commit real values.
META_APP_ID=
META_APP_SECRET=
# https://<PUBLIC_URL host>/api/social/oauth/meta/callback  (Valid OAuth Redirect URIs in the Meta app)
META_REDIRECT_URI=
META_GRAPH_VERSION=v25.0
THREADS_APP_ID=
THREADS_APP_SECRET=
# https://<PUBLIC_URL host>/api/social/oauth/threads/callback
THREADS_REDIRECT_URI=
# Public https origin that serves ONLY /api/social/media/* (Threads and Instagram images fetch media by URL). Optional.
SOCIAL_PUBLIC_MEDIA_BASE_URL=
