{
  "name": "vireon-ai-backend",
  "version": "1.0.0",
  "description": "Vireon AI - AI-powered video generation platform backend",
  "main": "src/server.js",
  "scripts": {
    "minio": "powershell -NoProfile -ExecutionPolicy Bypass -File \"D:\\Programs\\minio\\start-minio.ps1\"",
    "server:only": "node src/server.js",
    "server:only:dev": "node --watch src/server.js",
    "worker:only": "node src/workers/videoWorker.js",
    "worker:only:dev": "node --watch src/workers/videoWorker.js",
    "course-worker:only": "node src/workers/courseVideoWorker.js",
    "course-worker:only:dev": "node --watch src/workers/courseVideoWorker.js",
    "start": "concurrently -n MINIO,SERVER -c yellow,cyan --kill-others-on-fail=false \"npm:minio\" \"npm:server:only\"",
    "dev": "concurrently -n MINIO,SERVER -c yellow,cyan --kill-others-on-fail=false \"npm:minio\" \"npm:server:only:dev\"",
    "worker": "concurrently -n MINIO,WORKER -c yellow,green --kill-others-on-fail=false \"npm:minio\" \"npm:worker:only\"",
    "worker:dev": "concurrently -n MINIO,WORKER -c yellow,green --kill-others-on-fail=false \"npm:minio\" \"npm:worker:only:dev\"",
    "course-worker": "concurrently -n MINIO,COURSE-WORKER -c yellow,green --kill-others-on-fail=false \"npm:minio\" \"npm:course-worker:only\"",
    "course-worker:dev": "concurrently -n MINIO,COURSE-WORKER -c yellow,green --kill-others-on-fail=false \"npm:minio\" \"npm:course-worker:only:dev\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/"
  },
  "keywords": [
    "vireon",
    "ai",
    "video",
    "generation"
  ],
  "author": "Vireon AI",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@gradio/client": "^2.3.1",
    "archiver": "^7.0.1",
    "audio-decode": "^3.11.4",
    "axios": "^1.18.1",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "minio": "^8.0.7",
    "mongoose": "^8.9.5",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.16",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "eslint": "^9.18.0",
    "jest": "^29.7.0"
  }
}
