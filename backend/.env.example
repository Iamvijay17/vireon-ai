# Used by the NATIVE workers (and local dev). Copy to backend/.env. Never commit .env.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

MONGODB_URI=
REDIS_HOST=localhost
REDIS_PORT=6379

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PUBLIC_URL=http://127.0.0.1:9000

# Must match the URL users open (docker-compose PUBLIC_URL)
CORS_ORIGIN=http://localhost:5173

LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# TTS_START_COMMAND / TTS_WORKDIR / AVATAR_* / COMFYUI_* : keep your existing values

# One video job at a time: a 6 GB GPU + CPU Remotion renders do not share well
VIDEO_WORKER_CONCURRENCY=1
