# Used by the NATIVE workers (and local dev). Copy to backend/.env. Never commit .env.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

MONGODB_URI=
# Production: Redis runs in Docker (published on 127.0.0.1:6379). Use the IPv4 address,
# not `localhost` (which resolves to IPv6 ::1 first and can miss Docker's Redis), and never let
# the worker start its own Redis - it launches at logon, possibly before Docker is up, and a
# second Redis splits the queue (API on Docker's, workers on the stray one).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_AUTOSTART=false

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PUBLIC_URL=http://127.0.0.1:9000
# Used only by `npm run minio` (and start/dev/worker*) to launch MinIO locally.
# Leave MINIO_DATA_DIR empty if MinIO is started some other way.
MINIO_EXE=
MINIO_DATA_DIR=
MINIO_CONSOLE_PORT=9001

# Must match the URL users open (docker-compose PUBLIC_URL)
CORS_ORIGIN=http://localhost:5173

OLLAMA_URL=http://localhost:11434
# TTS_START_COMMAND / TTS_WORKDIR / COMFYUI_* : keep your existing values

# One video job at a time: a 6 GB GPU + CPU Remotion renders do not share well
VIDEO_WORKER_CONCURRENCY=1

# The video worker and the course-video worker are separate processes (see
# deploy/install-workers.ps1) and both load models onto the one 6 GB GPU.
# Without this, each only knows its own process's slot accounting and they can
# load LM/TTS on top of each other. 'redis' makes them take a shared lease.
GPU_COORDINATOR=redis

# --- Narration pipeline (Voice Director, sentence-level TTS, post-processing). Off by default:
# with it off, narration is one TTS call per scene as before. See backend/README.md.
# TTS_SEGMENTED=true
# FFMPEG_PATH=C:\path	ofmpeg.exe     # needed for loudness/EQ/speed; without it audio is left unprocessed
# FFPROBE_PATH=C:\path	ofprobe.exe
# TARGET_LOUDNESS=-16                      # LUFS; same for every clip, scene and video
# TRUE_PEAK_LIMIT=-1.5                     # dBTP
# COMPRESSION_ENABLED=true
# NORMALIZATION_ENABLED=true
# TTS_SPEED_MIN=0.85
# TTS_SPEED_MAX=1.2
# PAUSE_COMMA_MS=120  PAUSE_SENTENCE_MS=320  PAUSE_PARAGRAPH_MS=700  PAUSE_SCENE_TRANSITION_MS=400
# PAUSE_MIN_MS=0      PAUSE_MAX_MS=1500
# ALIGNMENT_PROVIDER=faster-whisper        # or "none" to use estimated caption pacing
# VOICE_PROFILES_FILE=C:\path	o\my-profiles.json   # extra voice profiles, same shape as pipeline/voiceProfiles/profiles.json

# --- Scene images (ComfyUI). Off by default: with it off, scenes the Director wanted an
# image for are rendered as text-only scenes, and nothing fails. See workflows/README.md.
# COMFYUI_ENABLED=true
# COMFYUI_CHECKPOINT=<checkpoint file name as ComfyUI lists it>
# COMFYUI_API_URL=http://127.0.0.1:8188
# IMAGE_MAX_PER_VIDEO=6
# IMAGE_GEN_REQUIRED=false

# Optional: scene image URLs that point at private/internal hosts are refused at
# render time (SSRF guard). MinIO's own MINIO_PUBLIC_URL is always allowed; list
# any other internal image host here, comma-separated (hostname or host:port).
# IMAGE_URL_ALLOWED_HOSTS=

# --- Layout check. Renders each scene in headless Chromium just before the video render and
# reports text that is cut off or off-frame, overlapping text, images that did not load.
# Off by default (adds a Remotion bundle + a few seconds per video). Reports only, unless
# QC_FAIL_ON_ERROR=true makes errors stop the render. On demand: node scripts/layoutQc.js --job <id>
# QC_ENABLED=true
# QC_FAIL_ON_ERROR=false

# Expire cached TTS audio / scene images after this many days (0 = keep forever).
# MinIO does the deleting; a missing cache entry is just regenerated.
# CACHE_RETENTION_DAYS=0
